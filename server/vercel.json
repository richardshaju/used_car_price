
  {
    "version": 2,
    "builds": [
      {
        "src": "server.py",
        "use": "@vercel/python",
        "config": {
          "buildCommand": "python server.py",
          "outputDirectory": ".",
          "installCommand": "pip install -r requirements.txt",
          "runtime": "python3.9"
        }
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "server.py"
      }
    ]
  }